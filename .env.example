# ─────────────────────────────────────────────
# TELEGRAM
# ─────────────────────────────────────────────
BOT_TOKEN=
ADMIN_TELEGRAM_ID=
ADMIN_GROUP_ID=

# ─────────────────────────────────────────────
# STATISTIQUES (fichier local, rempli manuellement — voir data/README.md)
# Laissez vide pour utiliser data/stats.json par défaut.
# ─────────────────────────────────────────────
STATS_FILE_PATH=

# ─────────────────────────────────────────────
# PAIEMENT WAVE (lien direct, montant ajouté automatiquement)
# ─────────────────────────────────────────────
WAVE_PAY_LINK_BASE=https://pay.wave.com/m/M_ci_knlRyepWBd4f/c/ci/?amount=

# ─────────────────────────────────────────────
# BASE DE DONNÉES
# Sur Render, monter un disque persistant et pointer vers /data/database.sqlite
# En local, une valeur par défaut (./database.sqlite) est utilisée si vide.
# ─────────────────────────────────────────────
DATABASE_PATH=./database.sqlite

# ─────────────────────────────────────────────
# PRONOSTICS AUTOMATIQUES QUOTIDIENS
# Format cron (par défaut : tous les jours à 08h00, heure du serveur)
# Nombre de matchs publiés dans le message quotidien
# ─────────────────────────────────────────────
DAILY_CRON_SCHEDULE=0 8 * * *
DAILY_PREDICTIONS_COUNT=5

# ─────────────────────────────────────────────
# SERVEUR
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=production