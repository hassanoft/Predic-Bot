# ─────────────────────────────────────────────
# TELEGRAM
# ─────────────────────────────────────────────
BOT_TOKEN=
ADMIN_TELEGRAM_ID=
ADMIN_GROUP_ID=

# ─────────────────────────────────────────────
# API FOOTBALL PREDICTION (RapidAPI)
# ─────────────────────────────────────────────
RAPIDAPI_KEY=
RAPIDAPI_HOST=football-prediction-api.p.rapidapi.com
RAPIDAPI_URL=https://football-prediction-api.p.rapidapi.com/api/v2/predictions

# ─────────────────────────────────────────────
# MOYENS DE PAIEMENT (numéros affichés aux utilisateurs)
# ─────────────────────────────────────────────
ORANGE_MONEY_NUMBER=
MTN_MOMO_NUMBER=
MOOV_MONEY_NUMBER=
WAVE_NUMBER=

# ─────────────────────────────────────────────
# BASE DE DONNÉES
# Sur Render, monter un disque persistant et pointer vers /data/database.sqlite
# En local, une valeur par défaut (./database.sqlite) est utilisée si vide.
# ─────────────────────────────────────────────
DATABASE_PATH=./database.sqlite

# ─────────────────────────────────────────────
# PRONOSTICS AUTOMATIQUES QUOTIDIENS
# Format cron (par défaut : tous les jours à 08h00, heure du serveur)
# Nombre de matchs publiés dans le message quotidien
# ─────────────────────────────────────────────
DAILY_CRON_SCHEDULE=0 8 * * *
DAILY_PREDICTIONS_COUNT=5

# ─────────────────────────────────────────────
# SERVEUR
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=production
